# 配置模板：从 app 的父目录执行 cp app/.env.example .env，然后填写真实配置。
# 请勿把 .env 放进 app/：自动根目录定位会把 .env 所在目录作为 PROJECT_ROOT。
# 此模板不包含可用凭据，空值不是可运行配置；先按实际环境补齐再启动。
# 密钥只保存在本地 .env 或进程环境中，不提交到 Git。

# 根目录（选填）
# 一般无需设置；代码会向上寻找父目录 .env。若在进程环境设置，应为父目录绝对路径。
# PROJECT_ROOT=

# 大语言模型 / 视觉模型
OPENAI_BASE_URL=
OPENAI_API_KEY=
VL_MODEL=
LLM_DEFAULT_MODEL=
# 必填数值：代码直接 float(...) 转换，空值或缺失会报错。
LLM_DEFAULT_TEMPERATURE=

# 百炼 MCP / MinerU
MCP_DASHSCOPE_BASE_URL_STREAMABLE=
MINERU_BASE_URL=
MINERU_API_TOKEN=

# Embedding 模型
BGE_M3_PATH=
BGE_M3=
BGE_DEVICE=
# 布尔值：填 1 或 true 启用，填 0 或 false 关闭。
BGE_FP16=

# Reranker 模型
BGE_RERANKER_LARGE=
BGE_RERANKER_DEVICE=
# 布尔值：填 1 或 true 启用，填 0 或 false 关闭。
BGE_RERANKER_FP16=

# Milvus
MILVUS_URL=
CHUNKS_COLLECTION=
ENTITY_NAME_COLLECTION=
ITEM_NAME_COLLECTION=

# MinIO
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_IMG_DIR=
# 必须按需填写 True 或 False；当前代码仅将大小写完全一致的 True 识别为启用。
MINIO_SECURE=

# MongoDB
MONGO_URL=
MONGO_DB_NAME=

# Neo4j
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# 日志（选填，保持注释时使用代码默认值）
# LOG_CONSOLE_ENABLE=
# LOG_CONSOLE_LEVEL=
# LOG_FILE_ENABLE=
# LOG_FILE_LEVEL=
# LOG_FILE_RETENTION=

